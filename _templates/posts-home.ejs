<% if (items.length > 0) { %>
<h2>Latest writing</h2>
<ul class="post-list">
<% for (const item of items) { %>
<li class="post">
<p class="post-date"><%= item.date %></p>
<div>
<p class="post-title"><a href="<%- item.path %>"><%= item.title %></a></p>
<% if (item.description) { %><p class="post-desc"><%= item.description %></p><% } %>
</div>
</li>
<% } %>
</ul>
<% } %>
